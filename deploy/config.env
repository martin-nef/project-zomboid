# Here to trigger deploys
CFG_VERSION=3

SERVER_NAME=StrayDogs

# Steam branch the dedicated server installs. Players' clients follow "public",
# and PZ refuses to connect a client whose version differs from the server's,
# so only change this together with the players. Project Viewpoint is pinned to
# one game version (versionMin = versionMax = 42.21), so a game update breaks it
# until Viewpoint catches up: then set the matching beta (e.g. 42.21) here and
# have everyone pick it in Steam.
STEAM_BRANCH=public
# 1 = verify every game file on start (slow); the first install always does.
STEAM_VALIDATE=0

# JVM heap. The container limit in statefulset.yaml leaves ~3 GiB on top of it.
JAVA_XMX=5g

# SteamID64s whose signed ZombieBuddy Java mods load without an approval
# prompt, so their updates don't need anyone to re-approve them. Any other Java
# mod is denied (the prompt reads EOF from the closed stdin), which is fine
# for client-only jars like Viewpoint's: the server still loads their Lua.
#   76561198043849998 = Zed (ZombieBuddy)
ZB_TRUSTED_AUTHORS=76561198043849998

# Workshop items whose unsigned server-side Java mods (media/java/server/ or
# media/java/, not client/) the server approves, whatever version they're at:
# start.sh downloads these items before the server starts and approves the
# current JAR hashes. This trusts the items' authors to run code on the server.
# tools/collection.py says when the mod list needs one added.
#   3812702301 = Viewpoint Advanced Movement (ViewpointAdvancedMovementServer)
#   3812864848 = Viewpoint True Ballistics (server-side hit checks)
#   3813908957 = Viewpoint True Weathers & Lighting (Gameplay part)
#   3817555882 = Rolling Hills Physics
ZB_APPROVED_ITEMS=3812702301 3812864848 3813908957 3817555882

# How often the updater sidecar checks for game and Workshop updates (seconds),
# and how long players get warned before the restart (minutes).
UPDATE_CHECK_INTERVAL=600
UPDATE_WARNING_MINUTES=5

# Secrets (deploy/secrets.yaml, `sops deploy/secrets.yaml` to edit):
#   SERVER_PASSWORD  players' join password
#   ADMIN_PASSWORD   in-game "admin" account, set when the server first creates its database
#   RCON_PASSWORD    used by the probes and the updater; RCON is not exposed outside the pod network
